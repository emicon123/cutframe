{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutframe",
  "identifier": "app.cutframe.editor",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cutframe",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0d0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost media: http://media.localhost; img-src 'self' data: media: http://media.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["cutframe"],
        "name": "Cutframe.Project",
        "description": "Cutframe Project",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../.ffmpeg/bin/*.dll": "",
      "../.ffmpeg/LICENSE.txt": "licenses/ffmpeg/LICENSE.txt",
      "../.ffmpeg/NOTICE.txt": "licenses/ffmpeg/NOTICE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/emicon123/cutframe/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER: paste the public key printed by `pnpm tauri signer generate` here",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
