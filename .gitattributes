# Keep LF in the repository and in every working tree, including Windows checkouts with
# core.autocrlf=true. Prettier and rustfmt expect LF; CRLF makes `prettier --check` fail.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.mp4 binary
